+  Future<List<({String title, String url, String content})>> _searchParallel(
+    http.Client client,
+    String query,
+  ) async {
+    final parallelCheck = await _ssrf.checkUrl(parallelBaseUrl);
+    if (parallelCheck != null) {
+      throw _SearchFailure(
+        'Parallel base URL ditolak: $parallelCheck',
+        fallbackEligible: true,
+      );
+    }
+    final uri = Uri.parse('$parallelBaseUrl/v1/search');
+    final body = jsonEncode({
+      'mode': 'fast',
+      'objective': query,
+      'search_queries': [query],
+    });
+    final res = await client
+        .post(
+          uri,
+          headers: {
+            'Content-Type': 'application/json',
+            'x-api-key': parallelApiKey!,
+          },
+          body: body,
+        )
+        .timeout(const Duration(seconds: 25));
+    if (res.statusCode < 200 || res.statusCode >= 300) {
+      throw _SearchFailure(
+        'Parallel HTTP ${res.statusCode}: ${res.body.length > 200 ? res.body.substring(0, 200) : res.body}',
+        fallbackEligible: res.statusCode >= 500 || res.statusCode == 429,
+      );
+    }
+    final json = jsonDecode(res.body) as Map<String, dynamic>;
+    // Parallel returns results with url / title / excerpts (or content)
+    final results = json['results'] as List<dynamic>? ??
+        json['data'] as List<dynamic>? ??
+        [];
+    final hits = <({String title, String url, String content})>[];
+    for (final raw in results) {
+      if (raw is! Map<String, dynamic>) continue;
+      final title = (raw['title'] as String?) ??
+          (raw['name'] as String?) ??
+          '(tanpa judul)';
+      final url = (raw['url'] as String?) ??
+          (raw['link'] as String?) ??
+          '';
+      String content = '';
+      final excerpts = raw['excerpts'] ?? raw['excerpt'];
+      if (excerpts is List) {
+        content = excerpts.map((e) => e.toString()).join(' ');
+      } else if (excerpts is String) {
+        content = excerpts;
+      } else {
+        content = (raw['content'] as String?) ??
+            (raw['snippet'] as String?) ??
+            (raw['text'] as String?) ??
+            '';
+      }
+      if (url.isNotEmpty) {
+        hits.add((title: title, url: url, content: content));
+      }
+    }
+    return hits;
+  }
